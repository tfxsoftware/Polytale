{
  "name": "polytale",
  "private": true,
  "version": "0.1.0",
  "description": "Engine 3D de contação de histórias (diálogos, animação procedural, estética PS1/90s) em Vite + TypeScript + Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema": "vite-node scripts/schema.ts --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.180.0",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}

    {"time": 23.19, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Forty years of repairs, and every one of them is in this book.", "cutaway": "logbook"},
    {"time": 28.48, "type": "TRANSFORM_OBJECT", "target": "ines", "position": [-0.4, 0, -0.5], "rotation": [0, 40, 0], "duration": 2.32, "easing": "easeInOutSine"},
    {"time": 28.48, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "logbook"},
    {"time": 28.48, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Left arm, nineteen years ago. Right arm, the winter after that."},
    {"time": 33.85, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Knees, twice. The chest plate after the flood."},
    {"time": 37.96, "type": "SET_EXPRESSION", "target": "ines", "expression": "neutral"},
    {"time": 37.96, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "ott"},
    {"time": 37.96, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Your eyes I changed last spring, and you complained about the colour."},
    {"time": 44.07, "type": "SET_EXPRESSION", "target": "ott", "expression": "happy", "intensity": 0.7},
    {"time": 44.07, "type": "PLAY_GESTURE", "target": "ott", "gesture": "shrug"},
    {"time": 44.07, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "They were too green. I remember being annoyed."},
    {"time": 48.47, "type": "SET_EXPRESSION", "target": "ines", "expression": "happy", "intensity": 0.6},
    {"time": 48.47, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "There it is. You remember. Keep hold of that thought while I make tea."},
    {"time": 54.06, "type": "INTERACT", "target": "ines", "interaction": "putDown", "object": "logbook", "position": [-1.2, 0.8, -1.45]},
    {"time": 57.46, "type": "INTERACT", "target": "ines", "interaction": "pickUp", "with": "mug"},

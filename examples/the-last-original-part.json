    {"time": 57.46, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Sailors had a story about this. A ship repaired plank by plank.", "cutaway": "steam"},
    {"time": 62.83, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "When the last old plank is gone, is it still the same ship?"},
    {"time": 67.9, "type": "TRANSFORM_OBJECT", "target": "ines", "position": [-0.1, 0, 1.3], "rotation": [0, 90, 0], "duration": 2.17, "easing": "easeInOutSine"},
    {"time": 70.06, "type": "INTERACT", "target": "ines", "interaction": "give", "object": "mug", "approach": false, "with": "ott"},

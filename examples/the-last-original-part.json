    {"time": 143.93, "type": "TRANSFORM_OBJECT", "target": "ines", "rotation": [0, -100, 0], "duration": 0.6, "easing": "easeInOutSine"},
    {"time": 144.63, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "This. The first core. I took it out in the autumn and never told you.", "cutaway": "core"},
    {"time": 150.74, "type": "SET_EXPRESSION", "target": "ott", "expression": "surprised", "intensity": 1.1},
    {"time": 150.74, "type": "TRANSFORM_OBJECT", "target": "ott", "position": [1.5, 0, -1.2], "rotation": [0, 100, 0], "duration": 0.86, "easing": "easeInOutSine"},
    {"time": 150.74, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "That was inside me?"},
    {"time": 153.15, "type": "INTERACT", "target": "ines", "interaction": "give", "object": "core", "approach": false, "with": "ott"},
    {"time": 155.75, "type": "SET_EXPRESSION", "target": "ott", "expression": "thinking", "intensity": 0.9},
    {"time": 155.75, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Then the last plank left in the autumn, and I did not notice."},
    {"time": 161.27, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "security_monitor"},
    {"time": 161.27, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "I still had opinions about my eyes.", "cutaway": "security_monitor"},
    {"time": 164.86, "type": "SET_POSE", "target": "ines", "pose": "armsCrossed", "duration": 0.7},
    {"time": 164.86, "type": "SET_EXPRESSION", "target": "ines", "expression": "happy", "intensity": 0.5},
    {"time": 164.86, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "You did. Very loud ones."},
    {"time": 167.84, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "camera"},
    {"time": 167.84, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Look at the monitor. It shows a machine holding a light."},
    {"time": 172.78, "type": "SET_EXPRESSION", "target": "ott", "expression": "neutral"},
    {"time": 172.78, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "I keep waiting to feel that he is someone else. I do not."},
    {"time": 178.21, "type": "SET_LIGHT", "target": "sun", "intensity": 0, "color": "#b0324a", "duration": 9},
    {"time": 178.21, "type": "SET_LIGHT", "target": "lamp", "intensity": 5, "duration": 7},

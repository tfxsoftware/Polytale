    {"time": 10.84, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Hold still, or that answer changes while I am working."},
    {"time": 15.54, "type": "SET_EXPRESSION", "target": "ott", "expression": "neutral"},
    {"time": 15.54, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "I am serious. Tell me what is left from the day I was built."},
    {"time": 20.99, "type": "SET_EXPRESSION", "target": "ines", "expression": "thinking"},
    {"time": 20.99, "type": "INTERACT", "target": "ines", "interaction": "pickUp", "with": "logbook"},

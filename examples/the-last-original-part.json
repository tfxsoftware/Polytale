    {"time": 210.07, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "ines"},
    {"time": 210.07, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "I still cannot drink it."},
    {"time": 212.44, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Same ship, then."},

    {"time": 72.66, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "ott"},
    {"time": 74.46, "type": "SET_EXPRESSION", "target": "ines", "expression": "thinking"},
    {"time": 74.46, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "I knew a man who said the plank was never the point."},
    {"time": 78.81, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "The ship is whatever the sailors keep trusting.", "cutaway": "mug"},
    {"time": 83.3, "type": "SET_EXPRESSION", "target": "ott", "expression": "surprised", "intensity": 0.6},
    {"time": 83.3, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "mug"},
    {"time": 83.3, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "You know that I cannot drink this."},
    {"time": 86.51, "type": "SET_EXPRESSION", "target": "ines", "expression": "happy"},
    {"time": 86.51, "type": "PLAY_GESTURE", "target": "ines", "gesture": "shrug"},
    {"time": 86.51, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "And yet you hold it every evening. That is rather my point."},
    {"time": 92.08, "type": "PLAY_SOUND", "src": "procedural:switch", "volume": 0.5},
    {"time": 92.08, "type": "SPAWN_OBJECT", "target": "old_face", "object": {"kind": "prop", "prop": "screen", "screen": {"src": "data:image/svg+xml;base64,", "effect": "dots", "width": 1.5, "height": 1.07, "bezel": true}}, "position": [0.2, 1.8, -3.4]},
    {"time": 92.08, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "old_face"},
    {"time": 92.08, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "old_face"},
    {"time": 93.08, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "That was you on your first morning. Copper face, terrible smile.", "cutaway": "old_face"},
    {"time": 98.62, "type": "DETACH_OBJECT", "target": "mug", "position": [0.55, 0.05, 1.85], "duration": 0.4},
    {"time": 99.12, "type": "INTERACT", "target": "ott", "interaction": "stand"},
    {"time": 99.92, "type": "TRANSFORM_OBJECT", "target": "ott", "position": [0.75, 0, -1.4], "rotation": [0, -150, 0], "duration": 2.71, "easing": "easeInOutSine"},
    {"time": 99.92, "type": "SET_EXPRESSION", "target": "ott", "expression": "sad", "intensity": 0.7},
    {"time": 99.92, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "I have that memory. But I only have it as a file."},
    {"time": 104.25, "type": "SET_LIGHT", "target": "sun", "color": "#ff7a3c", "intensity": 22, "duration": 10},
    {"time": 104.25, "type": "TRANSFORM_OBJECT", "target": "ott", "rotation": [0, -100, 0], "duration": 0.9, "easing": "easeInOutSine"},
    {"time": 104.25, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Someone wrote down being him, and I inherited the notes."},
    {"time": 109.3, "type": "PLAY_GESTURE", "target": "ott", "gesture": "headShake"},
    {"time": 109.3, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "What if he stopped existing years ago, and I only think I am him?"},
    {"time": 115.52, "type": "SET_EXPRESSION", "target": "ines", "expression": "sad", "intensity": 0.6},
    {"time": 115.52, "type": "INTERACT", "target": "ines", "interaction": "stand"},
    {"time": 116.32, "type": "TRANSFORM_OBJECT", "target": "ines", "position": [-1.7, 0, -0.75], "rotation": [0, 80, 0], "duration": 1.82, "easing": "easeInOutSine"},
    {"time": 116.32, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "I have replaced most of myself too, you know. Slower than you."},
    {"time": 121.61, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "ines"},
    {"time": 121.61, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "ott"},
    {"time": 121.61, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Every cell, they say. I do not remember being six, only remembering it."},
    {"time": 127.57, "type": "PLAY_GESTURE", "target": "ines", "gesture": "shrug"},
    {"time": 127.57, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Nobody ever opened me up and asked which part was Ines."},
    {"time": 132.84, "type": "SET_EXPRESSION", "target": "ines", "expression": "thinking"},
    {"time": 132.84, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "But you asked what is original. So here is the honest answer."},
    {"time": 137.76, "type": "TRANSFORM_OBJECT", "target": "ines", "position": [3.0, 0, -1.5], "rotation": [0, -100, 0], "duration": 3.97, "easing": "easeInOutSine"},
    {"time": 141.73, "type": "INTERACT", "target": "ines", "interaction": "pickUp", "with": "core"},
    {"time": 141.73, "type": "PLAY_SOUND", "src": "procedural:chime", "volume": 0.45},

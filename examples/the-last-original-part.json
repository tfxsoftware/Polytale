    {"time": 178.21, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": [-1.0, 1.2, 0.5]},
    {"time": 178.21, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Then maybe a person is not a thing you keep. Maybe it is a thing you do."},
    {"time": 184.34, "type": "TRANSFORM_OBJECT", "target": "ines", "position": [-0.95, 0, 1.3], "rotation": [0, 90, 0], "duration": 4.4, "easing": "easeInOutSine"},
    {"time": 184.34, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Every morning you pick the job back up, and you call it you."},
    {"time": 189.18, "type": "INTERACT", "target": "ines", "interaction": "sit", "position": [-0.95, 0, 1.3], "facing": 90, "seatHeight": 0.47, "approach": false},
    {"time": 189.18, "type": "TRANSFORM_OBJECT", "target": "ott", "position": [0.95, 0, 0.75], "rotation": [0, 0, 0], "duration": 2.03, "easing": "easeInOutSine"},
    {"time": 189.18, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "ines"},
    {"time": 189.18, "type": "SET_LOOK_TARGET", "target": "ines", "lookAt": "ott"},
    {"time": 191.81, "type": "TRANSFORM_OBJECT", "target": "ott", "position": [0.95, 0, 1.3], "rotation": [0, -90, 0], "duration": 0.8, "easing": "easeInOutSine"},
    {"time": 192.61, "type": "SET_POSE", "target": "ott", "pose": "sit", "seatHeight": 0.47, "duration": 0.7},
    {"time": 193.51, "type": "SET_EXPRESSION", "target": "ott", "expression": "thinking", "intensity": 0.6},
    {"time": 193.51, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Should I put it back?"},
    {"time": 196.47, "type": "SET_EXPRESSION", "target": "ines", "expression": "thinking", "intensity": 0.7},
    {"time": 196.47, "type": "SET_POSE", "target": "ines", "pose": "handOnChin", "duration": 0.7},
    {"time": 197.27, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "It would not make you more yourself. It would only be heavier."},
    {"time": 202.86, "type": "SET_POSE", "target": "ines", "pose": "sit", "seatHeight": 0.47, "duration": 0.6},
    {"time": 202.86, "type": "SET_EXPRESSION", "target": "ott", "expression": "happy", "intensity": 0.8},
    {"time": 202.86, "type": "PLAY_GESTURE", "target": "ott", "gesture": "nod"},
    {"time": 202.86, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ott", "text": "Then I will keep it on the shelf, and visit him."},
    {"time": 207.21, "type": "SET_EXPRESSION", "target": "ines", "expression": "happy", "intensity": 0.8},
    {"time": 207.21, "type": "SET_LOOK_TARGET", "target": "ott", "lookAt": "mug"},
    {"time": 207.21, "type": "PLAY_AUDIO_WITH_LIPSYNC", "target": "ines", "text": "Good. Now drink your tea."},
